---
import type { AlbumInfo } from "../data/spotify";

interface Props {
  albums: AlbumInfo[];
}

const { albums } = Astro.props;
---

<ol class="crate">
  {
    albums.map((a, i) => (
      <li>
        <a class="album" href={a.url} target="_blank" rel="noopener">
          <span class="sleeve">
            <span class="disc" aria-hidden="true" />
            {a.cover ? (
              <img src={a.cover} alt="" width="300" height="300" loading="lazy" decoding="async" />
            ) : (
              <span class="no-cover" aria-hidden="true">?</span>
            )}
            <span class="track-no" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          </span>
          <span class="meta">
            <span class="title">{a.title}</span>
            {a.artist && <span class="artist">{a.artist}</span>}
            {a.year && <span class="year">{a.year}</span>}
          </span>
          <span class="listen">
            Play on Spotify &#9654;<span class="sr-only"> (opens in a new tab)</span>
          </span>
        </a>
        {a.note && <p class="note">{a.note}</p>}
      </li>
    ))
  }
</ol>

<style>
  .crate {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 28px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crate li { display: flex; flex-direction: column; gap: 8px; }

  .album {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .sleeve {
    position: relative;
    display: block;
    aspect-ratio: 1;
    /* Room on the right for the record to slide out. */
    margin-right: 22%;
  }

  .sleeve img,
  .no-cover {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 3px solid #000;
    box-shadow: 0 0 0 3px var(--border), 6px 6px 0 #000;
    transition: box-shadow 0.15s steps(3);
  }

  .no-cover {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(45deg, var(--panel-2) 0 8px, #000 8px 16px);
    font-family: var(--pixel);
    font-size: 40px;
    color: var(--muted);
  }

  .disc {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--magenta) 0 14%, #000 14.5% 17%, transparent 17.5%),
      repeating-radial-gradient(circle, #1a1a2a 0 2px, #2c2c44 2px 4px);
    box-shadow: 0 0 0 2px #000, 0 0 12px rgba(255, 47, 214, 0.35);
    transform: translateX(14%);
    transition: transform 0.3s ease-out;
  }

  .track-no {
    position: absolute;
    z-index: 2;
    top: 6px;
    left: 6px;
    padding: 3px 5px;
    font-family: var(--pixel);
    font-size: 8px;
    color: #000;
    background: var(--yellow);
  }

  .album:hover .disc,
  .album:focus-visible .disc { transform: translateX(24%) rotate(180deg); }

  .album:hover img,
  .album:focus-visible img { box-shadow: 0 0 0 3px var(--cyan), 0 0 18px rgba(0, 240, 255, 0.5); }

  .album:focus-visible { outline: none; }
  .album:focus-visible .title { outline: 3px solid var(--yellow); outline-offset: 2px; }

  .meta { display: flex; flex-direction: column; gap: 2px; }

  .title {
    font-family: var(--pixel);
    font-size: 11px;
    line-height: 1.5;
    color: var(--cyan);
  }

  .artist { font-size: 20px; }
  .year { font-size: 18px; color: var(--muted); }

  .listen {
    align-self: flex-start;
    font-family: var(--pixel);
    font-size: 8px;
    color: var(--green);
  }

  .album:hover .listen { color: var(--yellow); }

  .note { margin: 0; font-size: 19px; color: var(--muted); }

  @media (max-width: 640px) {
    .crate { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 14px; }
    .title { font-size: 9px; }
    .artist { font-size: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .album:hover .disc,
    .album:focus-visible .disc { transform: translateX(24%); }
  }
</style>
