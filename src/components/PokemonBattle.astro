---
import PokedexDialog from "./PokedexDialog.astro";
import { site } from "../data/site";
---

<div
  class="arena"
  data-foe-team={JSON.stringify(site.pokemonTeam)}
  data-foe-name={site.handle}
  data-record-api={site.recordApi}
>
  <!-- Team select -->
  <div class="screen builder" data-screen="builder">
    <div class="builder-grid">
      <div>
        <p class="lead">
          Build a team of 6 and challenge my team. Every Pokémon fights at level 50 with maxed-out stats and its
          best ability.
        </p>
        <div class="builder-actions">
          <button class="btn" type="button" data-action="open-dex">Open Pokédex</button>
          <button class="btn yellow" type="button" data-action="random">Random team</button>
          <button class="btn ghost" type="button" data-action="clear">Clear</button>
        </div>
        <p class="msg" role="status" aria-live="polite"></p>
      </div>

      <div>
        <p class="label">Your team <span class="count">0/6</span></p>
        <ol class="slots player-slots"></ol>
        <p class="label">
          Rival: <span class="glow-magenta">{site.handle}</span>
          <span class="record" hidden></span>
        </p>
        <ol class="slots foe-slots"></ol>
      </div>
    </div>
    <button class="btn magenta start" type="button" data-action="start" disabled>Battle! &#9654;</button>
    <PokedexDialog />
  </div>

  <!-- Battle -->
  <div class="screen battle" data-screen="battle" hidden>
    <div class="stage">
      <div class="field" aria-live="polite"></div>
      <div class="info foe-info">
        <div class="info-top">
          <span class="info-name"></span><span class="info-status"></span><span class="info-lv">Lv50</span>
        </div>
        <div class="info-ability"></div>
        <div class="hpbar"><span></span></div>
        <div class="balls"></div>
      </div>
      <img class="sprite foe-sprite" alt="" width="192" height="192" />
      <img class="sprite player-sprite" alt="" width="192" height="192" />
      <div class="info player-info">
        <div class="info-top">
          <span class="info-name"></span><span class="info-status"></span><span class="info-lv">Lv50</span>
        </div>
        <div class="info-ability"></div>
        <div class="hpbar"><span></span></div>
        <div class="hp-num"></div>
        <div class="balls"></div>
      </div>
    </div>
    <div class="console">
      <p class="log" aria-live="polite"></p>
      <div class="commands">
        <div class="moves"></div>
        <div class="party" hidden></div>
        <div class="cmd-row">
          <button class="btn ghost" type="button" data-action="toggle-party">Switch</button>
          <button class="btn ghost" type="button" data-action="forfeit">Run</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Result -->
  <div class="screen result" data-screen="result" hidden>
    <p class="result-title"></p>
    <p class="result-sub"></p>
    <p class="record result-record" hidden></p>
    <div class="builder-actions">
      <button class="btn yellow" type="button" data-action="rematch">Rematch</button>
      <button class="btn ghost" type="button" data-action="new-team">New team</button>
    </div>
  </div>
</div>

<style>
  .arena { scroll-margin-top: 140px; }
  .record { margin-left: 12px; color: var(--yellow); }
  .result-record { margin: 0 0 24px; font-family: var(--pixel); font-size: 10px; }
  .lead { margin: 0 0 18px; }
  .label { font-family: var(--pixel); font-size: 10px; color: var(--muted); margin: 0 0 10px; }
  .msg { min-height: 1.3em; color: var(--yellow); margin: 12px 0 0; }

  .builder-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 32px;
  }

  .builder-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; }

  .slots {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }

  .slots :global(li) {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #000;
    border: 2px dashed var(--border);
    min-width: 0;
  }

  .slots :global(li.filled) { border-style: solid; border-color: var(--cyan); }
  .foe-slots :global(li.filled) { border-color: var(--magenta); }

  .slots :global(img) { width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; }

  .slots :global(.remove) {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    padding: 0;
    font-family: var(--pixel);
    font-size: 10px;
    color: #000;
    background: var(--red);
    border: 2px solid #000;
    cursor: pointer;
  }

  .slots :global(.slot-name) {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 2px;
  }

  .start { margin-top: 8px; font-size: 13px; padding: 14px 22px; }

  /* Battle stage */
  .stage {
    position: relative;
    height: 340px;
    background:
      radial-gradient(ellipse 120px 26px at 72% 42%, rgba(57, 255, 20, 0.35), transparent 70%),
      radial-gradient(ellipse 150px 30px at 25% 88%, rgba(0, 240, 255, 0.35), transparent 70%),
      linear-gradient(180deg, #1b1050 0%, #0a0a2a 55%, #062012 56%, #031208 100%);
    border: 3px solid var(--border);
    overflow: hidden;
  }

  .sprite {
    position: absolute;
    width: 192px;
    height: 192px;
    image-rendering: pixelated;
    transition: transform 0.2s steps(4), opacity 0.4s;
  }

  .foe-sprite { right: 12%; top: 12px; }
  .player-sprite { left: 10%; bottom: -6px; }
  .sprite.no-back { transform: scaleX(-1); }

  .sprite.hit { animation: flash 0.5s steps(2) 2; }
  .sprite.fainted { opacity: 0; transform: translateY(40px); }
  .foe-sprite.lunge { transform: translate(-24px, 12px); }
  .player-sprite.lunge { transform: translate(24px, -12px); }
  .player-sprite.no-back.lunge { transform: scaleX(-1) translate(-24px, -12px); }
  @keyframes flash { 50% { opacity: 0.1; } }

  .info {
    position: absolute;
    width: min(300px, 46%);
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.8);
    border: 3px solid var(--text);
    box-shadow: 4px 4px 0 #000;
  }

  .foe-info { left: 16px; top: 16px; }
  .player-info { right: 16px; bottom: 16px; }

  .info-top { display: flex; align-items: center; gap: 8px; font-family: var(--pixel); font-size: 10px; }
  .info-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .info-lv { color: var(--muted); margin-left: auto; }
  .info-status:not(:empty) { font-size: 8px; padding: 2px 4px; color: #000; background: var(--yellow); }
  .info-status.brn { background: #ff7a3c; }
  .info-status.psn { background: #c070ff; }
  .info-status.par { background: var(--yellow); }
  .info-status.slp { background: #9a9ac8; }
  .info-status.frz { background: #7fe3ff; }
  .info-ability { margin-top: 4px; font-size: 17px; color: var(--cyan); cursor: help; }

  .field:not(:empty) {
    position: absolute;
    right: 12px;
    top: 12px;
    z-index: 1;
    font-family: var(--pixel);
    font-size: 8px;
    padding: 4px 6px;
    color: #000;
    background: var(--yellow);
  }


  .hpbar {
    margin-top: 8px;
    height: 10px;
    background: #222;
    border: 2px solid #555;
  }

  .hpbar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--green);
    transition: width 0.6s steps(12), background-color 0.3s;
  }

  .hpbar span.mid { background: var(--yellow); }
  .hpbar span.low { background: var(--red); }

  .hp-num { text-align: right; font-size: 18px; margin-top: 2px; }

  .balls { display: flex; gap: 4px; margin-top: 6px; }
  .balls :global(i) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--red) 50%, #fff 50%);
    border: 1px solid #000;
  }
  .balls :global(i.out) { background: #444; }

  .console {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 16px;
    margin-top: 16px;
  }

  .log {
    margin: 0;
    min-height: 120px;
    padding: 14px 16px;
    background: #000;
    border: 3px solid var(--text);
    font-size: 24px;
  }

  .moves, .party {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .moves :global(button), .party :global(button) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 10px 12px;
    font-family: var(--pixel);
    font-size: 10px;
    text-align: left;
    color: #fff;
    background: #000;
    border: 3px solid var(--border);
    cursor: pointer;
  }

  .moves :global(button:hover:not(:disabled)), .party :global(button:hover:not(:disabled)) { border-color: var(--yellow); }
  .moves :global(button:disabled), .party :global(button:disabled) { opacity: 0.4; cursor: not-allowed; }
  .moves :global(.eff) { font-family: var(--mono); font-size: 16px; color: var(--muted); }
  .moves :global(.eff.good) { color: var(--green); }
  .moves :global(.eff.bad) { color: var(--red); }
  .moves :global(.meta) { display: flex; gap: 6px; align-items: center; }
  .moves :global(.pow) { font-family: var(--mono); font-size: 16px; color: var(--text); }
  .party :global(button) { flex-direction: row; align-items: center; }
  .party :global(img) { width: 40px; height: 40px; image-rendering: pixelated; }

  .cmd-row { display: flex; gap: 10px; margin-top: 10px; }

  .result { text-align: center; padding: 32px 0; }
  .result-title { font-family: var(--pixel); font-size: clamp(20px, 5vw, 40px); margin: 0 0 16px; }
  .result-sub { margin: 0 0 24px; }
  .result .builder-actions { justify-content: center; }

  @media (max-width: 800px) {
    .builder-grid, .console { grid-template-columns: 1fr; }
    .slots { grid-template-columns: repeat(3, 1fr); }
    .stage { height: 330px; }
    .sprite { width: 120px; height: 120px; }
    .foe-sprite { top: 88px; right: 3%; }
    .player-sprite { left: 2%; bottom: 0; }
    .info { width: 55%; padding: 6px 8px; }
    .foe-info { left: 8px; top: 8px; }
    .player-info { right: 8px; bottom: 8px; }
    .info-top { font-size: 8px; gap: 6px; }
    .info-ability { font-size: 15px; }
    .hp-num { font-size: 16px; }
    .field:not(:empty) { top: 64px; right: 8px; }
    .log { min-height: 96px; font-size: 20px; padding: 10px 12px; }
    .moves :global(button), .party :global(button) { font-size: 9px; padding: 8px; }
    .party :global(img) { width: 32px; height: 32px; }
    .cmd-row .btn { flex: 1; }
  }
</style>

<script>
  import { Battle, type BattleEvent, type Mon, type Side } from "../scripts/pokemon/battle";
  import { displayName, fetchPokemon, MAX_DEX, toBattler, type Battler } from "../scripts/pokemon/api";
  import { setupPokedex } from "../scripts/pokemon/pokedex";

  const root = document.querySelector<HTMLElement>(".arena")!;
  const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

  const foeNames: string[] = JSON.parse(root.dataset.foeTeam ?? "[]");
  const foeHandle = root.dataset.foeName ?? "Rival";
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduceMotion ? Math.min(ms, 250) : ms));

  let team: Battler[] = [];
  let foeTeam: Battler[] = [];
  let battle: Battle | null = null;
  let busy = false;

  function show(screen: string) {
    root.querySelectorAll<HTMLElement>("[data-screen]").forEach((el) => {
      el.hidden = el.dataset.screen !== screen;
    });
  }

  function setMsg(text: string) {
    $(".msg").textContent = text;
  }

  /* ---------- Win/loss record ---------- */

  const recordApi = root.dataset.recordApi ? `${root.dataset.recordApi.replace(/\/$/, "")}/record` : "";

  function showRecord(r: { wins: number; losses: number }) {
    const text = `Challengers ${r.wins}W - ${r.losses}L`;
    root.querySelectorAll<HTMLElement>(".record").forEach((el) => {
      el.textContent = text;
      el.hidden = false;
    });
  }

  async function recordRequest(init?: RequestInit) {
    if (!recordApi) return;
    try {
      const res = await fetch(recordApi, init);
      if (res.ok) showRecord(await res.json());
    } catch {
      // The record is a nice-to-have; battles work without it.
    }
  }

  function reportResult(result: "win" | "loss") {
    return recordRequest({
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ result }),
    });
  }

  function addScore(points: number) {
    const el = document.getElementById("hud-score");
    if (!el) return;
    const next = Math.min(999999, Number(el.textContent) + points);
    el.textContent = String(next).padStart(6, "0");
  }

  /* ---------- Team builder ---------- */

  function renderSlots(list: HTMLElement, mons: Battler[], removable: boolean) {
    list.replaceChildren(
      ...Array.from({ length: 6 }, (_, i) => {
        const li = document.createElement("li");
        const mon = mons[i];
        if (!mon) return li;
        li.className = "filled";
        li.title = `${displayName(mon.name)} (${mon.types.join("/")})\nAbility: ${displayName(mon.ability)}: ${mon.abilityDesc}`;
        const img = document.createElement("img");
        img.src = mon.front;
        img.alt = displayName(mon.name);
        img.loading = "lazy";
        const name = document.createElement("span");
        name.className = "slot-name";
        name.textContent = displayName(mon.name);
        li.append(img, name);
        if (removable) {
          const btn = document.createElement("button");
          btn.className = "remove";
          btn.type = "button";
          btn.textContent = "x";
          btn.setAttribute("aria-label", `Remove ${displayName(mon.name)}`);
          btn.addEventListener("click", () => {
            team.splice(i, 1);
            renderTeam();
          });
          li.append(btn);
        }
        return li;
      }),
    );
  }

  function renderTeam() {
    renderSlots($(".player-slots"), team, true);
    $(".count").textContent = `${team.length}/6`;
    $<HTMLButtonElement>("[data-action=start]").disabled = team.length !== 6 || foeTeam.length !== 6;
    dex.refresh();
  }

  async function addPokemon(name: string): Promise<boolean> {
    if (team.length >= 6 || team.some((m) => m.name === name)) return false;
    try {
      const mon = toBattler(await fetchPokemon(name));
      // The team may have changed while the request was in flight.
      if (team.length >= 6 || team.some((m) => m.name === mon.name)) return false;
      team.push(mon);
      setMsg("");
      renderTeam();
      return true;
    } catch {
      return false;
    }
  }

  const dex = setupPokedex($<HTMLDialogElement>("dialog.dex"), {
    getParty: () => team,
    add: addPokemon,
    remove: (i) => {
      team.splice(i, 1);
      renderTeam();
    },
  });

  async function randomTeam() {
    setMsg("Rolling...");
    const ids = new Set<number>();
    while (ids.size < 6) ids.add(1 + Math.floor(Math.random() * MAX_DEX));
    try {
      team = (await Promise.all([...ids].map((id) => fetchPokemon(id)))).map(toBattler);
      setMsg("");
    } catch {
      setMsg("PokéAPI isn't responding. Try again.");
    }
    renderTeam();
  }

  async function loadFoes() {
    try {
      foeTeam = (await Promise.all(foeNames.map((n) => fetchPokemon(n)))).map(toBattler);
      renderSlots($(".foe-slots"), foeTeam, false);
      renderTeam();
    } catch {
      setMsg("Couldn't reach PokéAPI. Refresh to try again.");
    }
  }

  /* ---------- Battle ---------- */

  // What the screen currently shows for each Pokémon. Events carry HP and
  // status snapshots, so the display can lag behind the engine's final state
  // while a turn plays out.
  type Shown = { hp: number; status: Mon["status"] };
  const shown: Record<Side, Shown[]> = { player: [], foe: [] };
  const onScreen: Record<Side, number> = { player: 0, foe: 0 };

  const FIELD_LABELS: Record<string, string> = {
    rain: "Rain",
    sun: "Harsh sun",
    sand: "Sandstorm",
    snow: "Snow",
    electric: "Electric Terrain",
    grassy: "Grassy Terrain",
    psychic: "Psychic Terrain",
    misty: "Misty Terrain",
  };

  const teamOf = (side: Side) => (side === "player" ? battle!.player : battle!.foe);

  function setHp(side: Side) {
    const mon = teamOf(side)[onScreen[side]];
    const { hp } = shown[side][onScreen[side]];
    const pct = hp / mon.maxHp;
    const bar = $(`.${side}-info .hpbar span`);
    bar.style.width = `${pct * 100}%`;
    bar.className = pct > 0.5 ? "" : pct > 0.2 ? "mid" : "low";
    if (side === "player") $(".hp-num").textContent = `${hp}/${mon.maxHp}`;
  }

  function setStatus(side: Side) {
    const { status } = shown[side][onScreen[side]];
    const el = $(`.${side}-info .info-status`);
    el.textContent = status ? status.toUpperCase() : "";
    el.className = `info-status ${status ?? ""}`;
  }

  function renderBalls(side: Side) {
    $(`.${side}-info .balls`).replaceChildren(
      ...shown[side].map((m) => {
        const i = document.createElement("i");
        if (m.hp === 0) i.className = "out";
        return i;
      }),
    );
  }

  function renderSide(side: Side) {
    const mon = teamOf(side)[onScreen[side]];
    const sprite = $<HTMLImageElement>(`.${side}-sprite`);
    const useBack = side === "player" && mon.back;
    sprite.src = side === "player" ? mon.back || mon.front : mon.front;
    sprite.alt = displayName(mon.name);
    sprite.className = `sprite ${side}-sprite${side === "player" && !useBack ? " no-back" : ""}`;
    $(`.${side}-info .info-name`).textContent = displayName(mon.name);
    const ability = $(`.${side}-info .info-ability`);
    ability.textContent = displayName(mon.baseAbility);
    ability.title = mon.abilityDesc;
    setHp(side);
    setStatus(side);
    renderBalls(side);
  }

  function effLabel(mult: number): [string, string] {
    if (mult === 0) return ["No effect", "bad"];
    if (mult > 1) return ["Super effective", "good"];
    if (mult < 1) return ["Not very effective", "bad"];
    return ["Effective", ""];
  }

  function renderCommands() {
    if (!battle) return;
    const b = battle;
    const mustSwitch = b.playerMustSwitch;
    const moves = $(".moves");
    const party = $(".party");

    moves.replaceChildren(
      ...b.playerMon.moves.map((m, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.disabled = busy || mustSwitch;
        const [label, cls] = effLabel(b.estimate("player", m).eff);
        const kind = m.category === "physical" ? "Phys" : "Spec";
        btn.title = [
          `${m.name}: ${m.power} power, ${m.accuracy ? `${m.accuracy}% accuracy` : "never misses"}.`,
          m.priority ? "Moves first." : "",
          m.contact ? "Makes contact." : "",
        ]
          .filter(Boolean)
          .join(" ");
        btn.innerHTML = `<span>${m.name}</span>
          <span class="meta"><span class="type type-${m.type}">${m.type}</span><span class="pow">${kind} ${m.power}</span></span>
          <span class="eff ${cls}">${label}</span>`;
        btn.addEventListener("click", () => play(b.turn({ kind: "move", index: i })));
        return btn;
      }),
    );

    party.replaceChildren(
      ...b.player.map((m, i) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.disabled = busy || m.hp === 0 || i === b.playerActive;
        btn.title = `Ability: ${displayName(m.baseAbility)}: ${m.abilityDesc}`;
        const status = m.status ? ` ${m.status.toUpperCase()}` : "";
        btn.innerHTML = `<img src="${m.front}" alt=""><span>${displayName(m.name)}<br>${m.hp}/${m.maxHp}${status}</span>`;
        btn.addEventListener("click", () => {
          party.hidden = true;
          moves.hidden = false;
          play(mustSwitch ? b.replace(i) : b.turn({ kind: "switch", to: i }));
        });
        return btn;
      }),
    );

    // A fainted or retreating Pokémon must be replaced before anything else.
    if (mustSwitch) {
      party.hidden = false;
      moves.hidden = true;
    }
    const toggle = $<HTMLButtonElement>("[data-action=toggle-party]");
    const trapped = !b.canPlayerSwitch();
    toggle.disabled = busy || mustSwitch || trapped;
    toggle.title = trapped ? "The foe's ability is trapping your Pokémon!" : "";
    $<HTMLButtonElement>("[data-action=forfeit]").disabled = busy;
  }

  async function play(events: BattleEvent[]) {
    if (!battle) return;
    busy = true;
    renderCommands();
    const log = $(".log");

    for (const ev of events) {
      if (ev.type === "text") {
        log.textContent = ev.text;
        await sleep(900);
      } else if (ev.type === "attack") {
        const s = $(`.${ev.side}-sprite`);
        s.classList.add("lunge");
        await sleep(200);
        s.classList.remove("lunge");
      } else if (ev.type === "hp") {
        shown[ev.side][ev.index].hp = ev.hp;
        if (ev.index !== onScreen[ev.side]) continue;
        const sprite = $(`.${ev.side}-sprite`);
        if (ev.delta < 0) sprite.classList.add("hit");
        setHp(ev.side);
        if (ev.side === "foe" && ev.delta < 0) addScore(-ev.delta * 10);
        await sleep(650);
        sprite.classList.remove("hit");
      } else if (ev.type === "status") {
        shown[ev.side][ev.index].status = ev.status;
        if (ev.index === onScreen[ev.side]) setStatus(ev.side);
      } else if (ev.type === "faint") {
        shown[ev.side][ev.index].hp = 0;
        shown[ev.side][ev.index].status = null;
        $(`.${ev.side}-sprite`).classList.add("fainted");
        setStatus(ev.side);
        renderBalls(ev.side);
        if (ev.side === "foe") addScore(1000);
        await sleep(600);
      } else if (ev.type === "switch") {
        onScreen[ev.side] = ev.index;
        shown[ev.side][ev.index] = { hp: ev.hp, status: ev.status };
        renderSide(ev.side);
        await sleep(300);
      } else if (ev.type === "field") {
        const parts = [ev.weather, ev.terrain].flatMap((k) => (k ? [FIELD_LABELS[k]] : []));
        $(".field").textContent = parts.join(" · ");
      }
    }

    busy = false;
    const winner = battle.winner;
    if (winner) return finish(winner);
    const name = displayName(battle.playerMon.name);
    if (!battle.playerMustSwitch) log.textContent = `What will ${name} do?`;
    else if (battle.playerMon.hp === 0) log.textContent = "Choose your next Pokémon!";
    else log.textContent = `${name} wants to retreat! Choose who goes in.`;
    renderCommands();
  }

  function finish(winner: Side) {
    const title = $(".result-title");
    if (winner === "player") {
      title.textContent = "You win!";
      title.className = "result-title glow-yellow";
      $(".result-sub").textContent = `You beat ${foeHandle}'s team. +5000 pts`;
      addScore(5000);
      reportResult("win");
    } else {
      title.textContent = "Game over";
      title.className = "result-title glow-magenta";
      $(".result-sub").textContent = `${foeHandle}'s team wins this round. Continue?`;
      reportResult("loss");
    }
    show("result");
  }

  function startBattle() {
    battle = new Battle(team, foeTeam, foeHandle);
    for (const side of ["player", "foe"] as Side[]) {
      shown[side] = teamOf(side).map((m) => ({ hp: m.hp, status: null }));
      onScreen[side] = 0;
    }
    show("battle");
    $(".party").hidden = true;
    $(".moves").hidden = false;
    $(".field").textContent = "";
    renderSide("player");
    renderSide("foe");
    play(battle.start());
    root.scrollIntoView({ block: "start" });
  }

  root.addEventListener("click", (e) => {
    const action = (e.target as HTMLElement).closest<HTMLElement>("[data-action]")?.dataset.action;
    if (!action) return;
    if (action === "open-dex") dex.open();
    if (action === "random") randomTeam();
    if (action === "clear") {
      team = [];
      renderTeam();
    }
    if (action === "start" || action === "rematch") startBattle();
    if (action === "new-team") show("builder");
    if (action === "forfeit" && !busy) finish("foe");
    if (action === "toggle-party" && !busy) {
      const party = $(".party");
      party.hidden = !party.hidden;
      $(".moves").hidden = !party.hidden;
    }
  });

  renderTeam();
  loadFoes();
  recordRequest();
</script>
